# =============================================================================
# Agente Cosmic — Example Environment File
# Copy to .env and fill in your values. Never commit .env to git.
# =============================================================================

# Django
DEBUG=False
SECRET_KEY=change-this-to-a-long-random-string
DJANGO_SETTINGS_MODULE=saas_chatbot.settings
ALLOWED_HOSTS=localhost,127.0.0.1,backend,your-domain.com

# Database — PostgreSQL
POSTGRES_DB=cosmic_db
POSTGRES_USER=cosmic_user
POSTGRES_PASSWORD=change-this-password
DB_NAME=cosmic_db
DB_USER=cosmic_user
DB_PASSWORD=change-this-password
DB_HOST=db
DB_PORT=5432

# Redis
REDIS_HOST=redis
REDIS_PASSWORD=

# -------------------------------------------------------------------------
# Google Cloud — required for Brand DNA extraction + image generation
# -------------------------------------------------------------------------
# Your GCP project where Vertex AI, Cloud Vision, and Cloud Storage are enabled
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_CLOUD_STORAGE_BUCKET=your-bucket-name

# Path to Application Default Credentials JSON inside the container
# Run: gcloud auth application-default login (on the host)
GOOGLE_APPLICATION_CREDENTIALS=/root/.config/gcloud/application_default_credentials.json

# Vertex AI models (defaults — change only if you have access to other regions/models)
VERTEX_TEXT_MODEL=publishers/google/models/gemini-2.5-flash
VERTEX_IMAGE_MODEL=publishers/google/models/gemini-2.5-flash-image

# -------------------------------------------------------------------------
# Email delivery — Mailgun
# -------------------------------------------------------------------------
MAILGUN_API_KEY=your-mailgun-api-key
MAILGUN_DOMAIN=your-verified-mailgun-domain.com
MAILGUN_SENDER_EMAIL=noreply@your-domain.com

# -------------------------------------------------------------------------
# Optional: Gemini API key (direct, not Vertex AI)
# Used only if you prefer Google AI Studio over Vertex AI
# -------------------------------------------------------------------------
GEMINI_API_KEY=

# -------------------------------------------------------------------------
# Optional: Legacy Telegram bot (inherited from miagent, not required)
# -------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_AUTHORIZED_CHAT_IDS=
